# ─── MusicJX :: environment config ───────────────────────────────
# Copy this file to `.env` and fill in the values. NEVER commit .env.

# Bot token — Developer Portal > your app > Bot > Reset Token
DISCORD_TOKEN=your-bot-token-here

# Application ID — Developer Portal > your app > General Information
CLIENT_ID=your-application-id-here

# (Optional) Your server ID(s). If set, `npm run deploy` registers commands
# to these servers instantly. Separate several with commas: 111,222
# Leave blank to register globally in every server (can take up to ~1h).
GUILD_ID=

# (Optional) YouTube cookie string if YouTube starts blocking requests
# ("Sign in to confirm you're not a bot"). Leave blank normally.
YOUTUBE_COOKIE=

# (Optional) Spotify search in /search. Create a free app at
# https://developer.spotify.com/dashboard and copy its Client ID / Client Secret.
# Spotify links in /play work without these.
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=

# (Optional) Verbose discord-player debug logs: true / false
DEBUG=false